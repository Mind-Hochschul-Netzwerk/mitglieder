{import form.latte}

{var $navId = $isSelf ? bearbeiten : suche}

{block htmlTitle}Profil bearbeiten{/block}
{block title}{$fullName}{/block}

{block css}
<style>
.page-header-image {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;

    #profile-picture + .profile-picture-button > div::after {
        display: inline-block;
        content: "ändern";
    }

    #profile-picture[src=""] {
        display: none;
        & + .profile-picture-button {
            opacity: 1;
            &::after { opacity: 0; }
            &:hover::after { opacity: 1; }
        }
        & + .profile-picture-button > div::after {
            content: "hochladen";
        }
    }
}

.profile-picture-button {
    position: absolute;
    top: 0;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column;
    width: 100%; height: 100%;
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.5s;

    & > i { font-size: 4rem; z-index: 1; }
    & > div { margin-top: 0.5rem; z-index: 1; }

    &::after {
        content: "";
        display: block;
        position: absolute;
        inset: 0;
        background: #c7d9ff;
        z-index: 0;
    }

    &:hover {
        opacity: 0.8;
        &::after { opacity: 1; }
    }
}
</style>
{/block}

{block header-image}
    <img src="{$user->profilePictureUrl}" alt="Profilbild von {$fullName}" id="profile-picture">
    <div class="profile-picture-button">
        <i class="ti ti-camera" aria-hidden="true"></i>
        <div>Profilbild </div>
    </div>
{/block}
{block page-label}<i class="ti ti-pencil" aria-hidden="true"></i> Profil bearbeiten{/block}
{block page-header}
    <div class="meta">
        <span n:if=$db_modified><strong>Stand:</strong> {$db_modified|format:'d.m.Y@local'}</span>
        <span n:if=$ort><i class="ti ti-map-pin" aria-hidden="true"></i> {$ort}</span>
    </div>
    <div class="action-links">
        <a href="/user/{$username}">
            <i class="ti ti-user" aria-hidden="true"></i> Profil ansehen
        </a>
        <button onclick="document.getElementById('password-change').showModal()">
            <i class="ti ti-lock" aria-hidden="true"></i> Passwort ändern
        </button>
    </div>
{/block}

{block content}
{var $changes = false}
{var $error = false}

{* Alerts generieren *}

{if $db_modified->diff(new \DateTimeImmutable('now - 1 year'))->invert === 0}
    {include info-box, warning, "Deine Daten wurden seit mindestens einem Jahr nicht geändert. Bitte prüfe, ob alles aktuell ist und klicke auf „Speichern“."}
{/if}

{if $email_error}
    {include info-box, danger, "Die einegebene E-Mail-Adresse ist ungültig. Die E-Mail-Adresse und wurde nicht gespeichert."}
    {var $changes = true}
    {var $error = true}
{/if}

{if str_ends_with(strtolower($email), '.invalid') && !$email_auth_info}
    {include info-box, danger, "E-Mails an dich kamen als unzustellbar zurück. Bitte aktualisiere deine E-Mail-Adresse."}
{/if}

{if $email_changed}
    {include info-box, success, "Deine E-Mail-Adresse wurde erfolgreich geändert."}
{/if}

{if $new_password2_error}
    {include info-box, danger, "Die neuen Passwörter stimmen nicht überein."}
{/if}

{if $old_password_error}
    {include info-box, danger, "Das alte Passwort ist falsch. Das Passwort wurde nicht geändert."}
{/if}

{if $set_new_password}
    {include info-box, success, "Dein Passwort wurde geändert."}
{/if}

{if $data_saved_info}
    {include info-box, success, (!$error ? 'Deine Daten wurden geändert.' : 'Die anderen Änderungen wurden gespeichert.') . ($email_auth_info ? ' Bitte schau in dein E-Mail-Postfach, um die Änderung deiner E-Mail-Adresse abzuschließen.')}
{/if}

{if $errorMessage}
    {include info-box, warning, $errorMessage}
{/if}

<form method="post" id="profile-form">
    {=csrfTokenTag()}

    {include "form.latte"}

    <section class="panel" aria-labelledby="membership-heading">
        <h2 id="membership-heading">
            <i class="label-icon ti ti-id-badge" aria-hidden="true"></i>Mitgliedskonto
        </h2>

        <dl>
            <div><dt>MHN-Mitgliedsnummer</dt><dd>{$id}</dd></div>
            <div><dt>Anmeldename</dt><dd>{$username}</dd></div>
            <div><dt>Aufnahmedatum</dt><dd>{($aufnahmedatum|format:'d.m.Y') ?? 'unbekannt'}</dd></div>
            <div><dt>Letzte Bearbeitung</dt>
                <dd>{($db_modified|format:'d.m.Y H:i@local') ?? unbekannt} durch
                <a n:tag-if="$db_modified_user" href="{$db_modified_user->profilUrl}">{$db_modified_user?->get('fullName') ?? 'unbekannt'}</a>
            </dd></div>
            <div><dt>Vereinseintritt</dt><dd>{($dateOfJoining|format:'d.m.Y') ?? 'kein Mitglied'}</dd></div>
            <div><dt>Datenschutzerklärungen</dt><dd><a href="/user/{$username}/agreements">Einwilligungen anzeigen / ändern</a></dd></div>
        </dl>

        <div>
            <h3>Vereinsaustritt</h3>
                {if $isAdmin && !$isSelf}
                    {include box, name: resign, label: 'Das Mitglied hat seinen Austritt erklärt.',
                        id: 'resignCheckbox',
                        onclick: 'return confirm("Bist du ganz sicher, dass dieses Häkchen " + (!document.getElementById("resignCheckbox").checked ? "entfernt" : "gesetzt") + " werden soll?")'
                    }
                    <p n:if=$resignation>Die Austrittserklärung wurde am {$resignation|format:'d.m.Y@local'} gespeichert.</p>
                {else}
                    {if $resignation}
                        <p>Deine Austrittserklärung wurde am {$resignation|format:'d.m.Y@local'} gespeichert. Wenn du deinen Austritt zurücknehmen möchtest, wende dich bitte an den <a href="mailto:vorstand@mind-hochschul-netzwerk.de">Vorstand</a>. Der Austritt wird gemäß unserer Satzung zum Ende des Kalenderjahres wirksam.</p>
                    {else}
                        <p>Hier kannst du gegenüber dem Vorstand deinen Austritt zum Ende des Kalenderjahres erklären. Mit dem Ende deiner Mitgliedschaft werden wir deine persönlichen Daten aus der Mitgliederdatenbank löschen.</p>
                        <p class="resign__button"><a href="/user/{$username}/resign" class="button danger"><i class="ti ti-logout" aria-hidden="true"></i> Austritt erklären</a></p>
                    {/if}
                {/if}
        </div>
    </section>

    <section class="panel" aria-labelledby="membership-heading" n:if=$isAdmin>
        <h2 id="membership-heading">
            <span class="label-icon ti ti-settings" aria-hidden="true"></span>Mitgliedsverwaltung
        </h2>

        <label>Gruppen</label>
        <p>{foreach explode(', ', $groups) as $group}<a href="/groups/{$group}">{$group}</a>{sep}, {/sep}{/foreach}</p>
        <a href="/groups" class="button"><i class="ti ti-users-group" aria-hidden="true"></i> Gruppen ändern</a>

        <div class="form-group">
            <label for="delete">Mitglied löschen</label>
            {include box, delete, 'Die Daten werden SOFORT endgültig und unwiederbringlich gelöscht! Die Mitglieder der Mitgliederbetreuung werden informiert.',
                id: delete,
                onclick: 'return confirm("Bist du ganz sicher?" + (!document.getElementById("delete").checked ? "" : " Daten werden unwiederbringlich gelöscht!"))'
            }
        </div>
    </section>

    <div class="form-actions sticky">
        <button type="submit"><i class="ti ti-device-floppy" aria-hidden="true"></i> Speichern</button>
    </div>

</form>
{/block}

{block footer}
{embed dialog, 'password-change', label: 'Zugangsdaten', labelIcon: 'key', title: 'Passwort ändern'}{block dialog-content}
    {include info-box, danger, "Die Wiederholung stimmt nicht mit dem neuen Passwort überein.", hide: !$new_password2_error, id: AlertWiederholungFalsch}

    <form action="/user/{$username}/password" method="post" id="passwordForm">
        {=csrfTokenTag()}

        {if !$isAdmin || $isSelf}
            {include private-form-group, 'Altes Passwort', password, type: password, value: null, autocomplete: 'current-password', required: true}
        {/if}
        {include private-form-group, 'Neues Passwort', new_password, type: password, value: null, autocomplete: 'new-password', required: true}
        {include private-form-group, 'Passwort wiederholen', new_password2, type: password, value: null, autocomplete: 'new-password', required: true}
        <div class="form-actions"><button type="submit"><i class="ti ti-device-floppy" aria-hidden="true"></i> Speichern</button></div>
    </form>
{/block}{/embed}

{embed dialog, 'profile-picture-dialog', labelIcon: camera, label: "Profilbild", title: "Profilbild ändern"}{block dialog-content}
    <p>Lade ein Profilbild hoch, damit andere eine Vorstellung haben, mit wem sie es zu tun haben. Das Profilbild ist für alle Mitglieder sichtbar.</p>

    <div class="form-group">
        <label>Aktuelles Bild</label>
        <img id="aktuellesBild" src="" alt="aktuelles Profilbild" style="max-width: 180px; border-radius: var(--radius-btn); margin: auto;">
    </div>

    <form enctype="multipart/form-data" action="/user/{$username}/profile-picture" method="post" id="profile-picture-form">
        {=csrfTokenTag()}

        <div class="form-group">
            <label for="profilbild">Bild ändern</label>
            <div>
                <div class="input-group">
                    <label for="profilbild" class="button">
                        <span class="button">
                            Datei auswählen &hellip;
                        </span>
                    </label>
                    <input name="profilbild" id="profilbild" type="file" accept="image/*">
                </div>
            </div>
        </div>

        <div id="delete-profile-picture" class="form-group">
            {include box, name: bildLoeschen, label: 'Bild löschen'}
        </div>

        <div class="form-actions">
            <button type="submit"><i class="ti ti-device-floppy" aria-hidden="true"></i> Speichern</button>
        </div>
    </form>
{/block}{/embed}

<script>
// vor dem Verlassen warnen, falls etwas geändert wurde
let changes = {$changes ? true : false};
let saving = false;

document.getElementById("profile-form").addEventListener('change', (e) => {
    changes = true;
});
document.getElementById("profile-form").addEventListener("submit", e => {
    saving = true;
});

window.addEventListener("beforeunload", e => {
    if (changes && !saving) {
        e.preventDefault();
        e.returnValue = "";
    }
});

document.getElementById("passwordForm").addEventListener("submit", e => {
    let input1 = document.querySelector("[name=new_password]").value;
    let input2 = document.querySelector("[name=new_password2]").value;
    if (input1 !== input2) {
        let alert = document.getElementById("AlertWiederholungFalsch");
        alert.classList.remove("hidden");
        alert.scrollIntoView();
        e.preventDefault();
    }
});

let sichtbarkeit_plz_ort_recursion = false;
document.querySelectorAll('[name=sichtbarkeit_plz_ort]').forEach(a => a.onchange = function () {
    if (sichtbarkeit_plz_ort_recursion) return;
    sichtbarkeit_plz_ort_recursion = true;
    const check = this.checked;
    document.querySelectorAll('[name=sichtbarkeit_plz_ort]').forEach(b => {
        if (a == b) return;
        b.checked = check;
    });
    sichtbarkeit_plz_ort_recursion = false;
});

document.querySelector(".page-header-image").addEventListener("click", () => {
    const src = document.getElementById("profile-picture").attributes.src.value;
    document.getElementById("input-bildLoeschen").checked = false;
    if (src) {
        document.getElementById("aktuellesBild").src = src;
        document.getElementById("delete-profile-picture").classList.remove("hidden");
    } else {
        document.getElementById("aktuellesBild").src = '/img/profilbild-default.png';
        document.getElementById("delete-profile-picture").classList.add("hidden");
    }
    document.getElementById("profile-picture-dialog").showModal();
});

document.getElementById("profile-picture-form").addEventListener("submit", e => {
    e.preventDefault();
    const formData = new FormData(e.target);
    callApi("POST", e.target.action, formData).then(response => {
        document.getElementById("profile-picture").src = response.src;
        document.getElementById("profile-picture-dialog").close();
    }).catch(() => alert("Beim Ändern des Profilbildes ist ein Fehler aufgetreten."));
});
</script>
{/block}
