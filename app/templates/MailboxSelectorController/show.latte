{var $navId = mail}

{block page-label}<i class="ti ti-mail" aria-hidden="true"></i> Kommunikation{/block}

{block title}Mailbox-Auswahl{/block}

{block css}
<style>
.mailbox-list {
    list-style: none;
    padding: 0;
    margin: 0;

    a  {
        border-radius: var(--radius-btn);
        border: solid var(--border) 1px;
	    display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.25rem;
        text-decoration: none;
        font-size: 0.95rem;
	    margin-bottom: 1rem;

        transition: translate 0.2s;

        &:hover {
            border-color: var(--accent);
            translate: 0px -2px;
            background-color: var(--accent-soft);
        }
    }
}
</style>
{/block}

{block content}
<section class="panel">
    <h2>Verfügbare Postfach-Adressen</h2>

    <p>Du hast Zugriff auf die folgenden MHN-Postfächer. Bitte wähle eine Adresse aus, um das zugehörige Postfach zu öffnen.</p>

    <ul class="mailbox-list">
        <li n:foreach="$mailboxes as $mailbox">
            <a href="/mail-login?mailbox={urlencode($mailbox)}" onclick="openMailbox(event, this)"><i class="ti ti-mail" aria-hidden="true"></i> {$mailbox}</a>
        </li>
        <li><a href="/mail-login?mailbox=login" onclick="openMailbox(event, this)"><i class="ti ti-lock" aria-hidden="true"></i> Mit E-Mail-Adresse und Passwort anmelden</a></li>
    </ul>
</section>

<script>
{syntax off}
// Beendet zuerst eine evtl. noch bestehende Mailu-Session, damit Mailu die neu gewählte
// Mailbox übernimmt (sonst bleibt man im zuvor geöffneten Postfach eingeloggt).
async function openMailbox(event, link) {
    event.preventDefault();
    try {
        await fetch(logoutUrl, {mode: 'no-cors', credentials: 'include', redirect: 'manual'});
    } catch (err) { /* Logout ist nur best effort */ }
    window.location.href = link.href;
}
{/syntax}
const logoutUrl = {$mailLogoutUrl};
</script>
{/block}
