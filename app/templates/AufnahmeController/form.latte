{var $navId = start}

{block css}
<style>

.uncover-toggle:has(:is(
    [name=sichtbarkeit_beruf],
    [name=sichtbarkeit_telefon],
    [name=sichtbarkeit_studienfach],
    [name=sichtbarkeit_unityp],
    [name=sichtbarkeit_studienort],
    [name=sichtbarkeit_schwerpunkt],
    [name=sichtbarkeit_nebenfach],
    [name=sichtbarkeit_abschluss],
    [name=sichtbarkeit_zweitstudium],
    [name=sichtbarkeit_stipendien],
    [name=sichtbarkeit_auslandsaufenthalte],
    [name=sichtbarkeit_praktika],
    [name=sichtbarkeit_mensa_nr],
    [name=sichtbarkeit_ehrenamt]
)) {
    display: none;
}

</style>
{/block}

{block title}Willkommen im Mind-Hochschul-Netzwerk{/block}

{block page-label}<i class="ti ti-user-plus" aria-hidden="true"></i> Aufnahme abschließen{/block}
{block page-header}
    <p>Hallo {$mhn_vorname},</p>
    <p>wir freuen uns, dich als neues Mitglied im Mind-Hochschul-Netzwerk zu begrüßen! Bevor es losgehen kann, musst du deine Zugangsdaten festlegen und entscheiden, welche Daten du im Netzwerk freigeben möchtest.</p>
{/block}

{block content}

{var $alerts = [
    usernameMissing: 'Bitte wähle einen Benutzernamen.',
    usernameInvalid: 'Dein Benutzername enthält ungültige Zeichen. Erlaubt sind Buchstaben, Zahlen, Punkte, Bindestriche und Unterstriche.',
    usernameUsed: 'Dieser Benutzername wird bereits verwendet.',
    emailUsed: "Zur E-Mail-Adresse $email existiert bereits ein Konto. Bitte wende dich an die Mitgliederbetreuung, um das Problem zu lösen.",
    passwordMissing: 'Bitte wähle ein Passwort.',
    passwordMismatch: 'Das Passwort und die Wiederholung stimmen nicht überein.',
]}

<form method="post" id="onboarding-form">
    {=csrfTokenTag()}

{foreach $alerts as $name=>$text}
    {if get_defined_vars()[$name]}
        <div>{include info-box, danger, $text}</div>
    {/if}
{/foreach}

<section class="panel" aria-label="Einstellungen zu deinem Benutzerzugang">
    <h2><i class="label-icon ti ti-key" aria-hidden="true"></i> Deine Zugangsdaten</h2>
    <p>
        Mit deinem Benutzernamen (Anmeldenamen) und deinem Passwort meldest du dich in unserem Mitgliedernetzwerk an.
        Bitte beachte, dass du deinen Benutzernamen nachträglich nicht mehr ändern kannst.
    </p>
    {include form-group, "Benutzername", username, required: true}
    {include form-group, "Passwort", password, type: password, placeholder: 'neues Passwort', autocomplete: 'new-password', required: true}
    {include form-group, "Passwort wiederholen", password2, type: password, placeholder: 'Passwort wiederholen', required: true}
</section>

<section class="panel" aria-label="Sichtbarkeit deiner Daten">
  <h2><i class="label-icon ti ti-eye" aria-hidden="true"></i> Was sollen andere Mitglieder sehen?</h2>

    <p>
        Unser Netzwerk lebt davon, dass die Mitglieder sich gegenseitig finden und
        miteinander in Kontakt treten können. Lege fest, welche Daten du im Netzwerk
        freigibst.
    </p>
    {include info-box, showCloseButton: false, text: "
        Was du nicht freigibst, ist nur für bestimme Personen wie Administrator*innen und die Mitgliederbetreuung
        sichtbar. Freigegebene Daten sind nur für Mitglieder sichtbar. Außerdem können Mitglieder
        dich über freigegebene Daten in der Mitgliedersuche finden. Deine angegeben Daten und die
        Freigabeeinstellungen kannst du jederzeit in deinem Mitgliedsprofil anpassen.
    "}

    {embed form-group, "Meine Adresse (Hauptwohnsitz)"}{block inputs}
        {include box, name: voreinstellung_adresse, type: radio, value: 1, required: true, label: "für Mitglieder freigeben"}
        {include box, name: voreinstellung_adresse, type: radio, value: 2, required: true, label: "eingeschränkt freigeben: nur PLZ, Ort und Land, aber nicht Straße/Hausnr. und Adresszusatz"}
        {include box, name: voreinstellung_adresse, type: radio, value: 0, required: true, label: "nicht freigeben"}
    {/block}{/embed}

    <div class="form-group">
        <label>E-Mail-Adresse</label>
        {include info-box, showCloseButton: false, text: "
            Über unsere Webseite können sich alle Mitglieder gegenseitig
            Direktnachrichten schicken, die per E-Mail zugestellt werden. Die E-Mail-Adressen werden dabei
            nicht preisgegeben.

            Darüber hinaus kannst du deine E-Mail-Adresse freigeben, sodass Mitglieder dich auch direkt per E-Mail anschreiben können.
        "}

        {include box, name: voreinstellung_email, type: radio, value: 1, required: true, label: "für Mitglieder freigeben"}
        {include box, name: voreinstellung_email, type: radio, value: 0, required: true, label: "nicht freigeben"}
    </div>

    {embed form-group, "Geburtsdatum / Alter"}{block inputs}
        {include box, name: voreinstellung_geburtstag, type: radio, value: 1, required: true, label: "für Mitglieder freigeben"}
        {include box, name: voreinstellung_geburtstag, type: radio, value: 0, required: true, label: "nicht freigeben"}
    {/block}{/embed}

    <p>

    </p>
</section>

{include info-box, showCloseButton: false, text: "
    Bitte überprüfe noch einmal deine Daten, bevor du unten auf speichern klickst und dem Verein beitrittst.
    Daten, die du nicht übernehmen möchtest, kannst du löschen.
"}

{include "../UserController/form.latte", isOnboardingForm: true}

{include info-box, showCloseButton: false, text: "
    Für alle Mitglieder immer sichtbar: dein Name, deine Mitgliedsnummer, dein
    Aufnahmedatum sowie deine Angaben zu Auskunft und Mitarbeit. Ein Profilbild
    kannst du nach der Registrierung hinzufügen.
"}

<div class="form-actions">
    <button type="submit"><i class="ti ti-check" aria-hidden="true"></i> Speichern und dem Verein beitreten</button>
</div>

</form>

{/block}

{block footer}
<script>
document.getElementById("onboarding-form").addEventListener("change", event => {
    if (event.target.matches("[name=voreinstellung_adresse]")) {
        document.querySelector("[name=sichtbarkeit_strasse]").checked = event.target.value == 1;
        document.querySelector("[name=sichtbarkeit_adresszusatz]").checked = event.target.value == 1;
        document.querySelectorAll("[name=sichtbarkeit_plz_ort]").forEach(el => el.checked = event.target.value >= 1);
        document.querySelector("[name=sichtbarkeit_land]").checked = event.target.value >= 1;
    }
    if (event.target.matches("[name=voreinstellung_email]")) {
        document.querySelector("[name=sichtbarkeit_email]").checked = event.target.value == 1;
    }
    if (event.target.matches("[name=voreinstellung_geburtstag]")) {
        document.querySelector("[name=sichtbarkeit_geburtstag]").checked = event.target.value == 1;
    }
});
</script>
{/block}