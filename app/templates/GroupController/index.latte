{var $navId = gruppen}

{block title}Gruppen{/block}
{block page-label}<i class="ti ti-users-group" aria-hidden="true"></i> Gruppen{/block}

{block page-header}
<div class="summary">
Hier findest du die Teams und anderen Gruppen im MHN. Um Ansprechpartner*innen zu finden, kannst du auf das jeweilige Team klicken. Außerdem kannst du hier deine Mitgliedschaft in Gruppen verwalten.
</div>
<div class="action-links" n:ifcontent>
    <button n:if=$isGroupAdmin onclick="document.getElementById('group-create-dialog').showModal()">
        <i class="ti ti-plus" aria-hidden="true"></i> Neue Gruppe
    </button>
</div>
{/block}

{block css}
<style>
.group-list { display: flex; flex-direction: column; gap: .5rem; }
.group-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem 1rem;
    padding: .75rem .95rem;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
}
.group-card-info { display: flex; flex-direction: column; gap: .2rem; flex: 1 1 14rem; min-width: 0; }
.group-card-name { font-weight: 600; }
.group-card-description {
    font-size: .9rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.group-card-meta {
    display: flex;
    align-items: center;
    gap: .55rem;
    flex-wrap: wrap;
    font-size: .8rem;
    color: var(--muted);
}
.badge {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-size: .72rem;
    font-weight: 600;
    padding: .2em .6em;
    border-radius: 99px;
    background: var(--accent-soft);
    color: var(--accent);
}
.badge.owner { background: #fef9c3; color: #713f12; }
.group-card[hidden], .group-filter-empty[hidden] { display: none; }
.group-filter { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.5rem; }
.group-filter-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
.group-filter-chips button {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .35rem .8rem;
    font-size: .8rem;
    font-weight: 600;
    border-radius: 99px;
    background: transparent;
    color: var(--muted);
    border: 1.5px solid var(--border);
}
.group-filter-chips button:hover, .group-filter-chips button:focus-visible { background: var(--panel-soft); }
.group-filter-chips button[aria-pressed=true] { background: var(--accent); border-color: var(--accent); color: #fff; }
.group-filter-chips .count { font-weight: 400; opacity: .8; }
.group-filter input[type=search] { width: 100%; max-width: 24rem; }
.group-filter-empty { color: var(--muted); }
.group-card-actions { flex-shrink: 0; }
.group-card-actions button {
    padding: .45rem .85rem;
    font-size: .8rem;
    font-weight: 600;
    white-space: nowrap;
}
.group-card-actions button.leave { color: var(--muted); }
</style>
{/block}

{block content}

{* Gruppen nach Kategorie gruppieren *}

{var $order = ['Teams', 'Rechte', 'System', 'Entwicklung']}
{var $byCategory = array_fill_keys($order, [])}
{foreach $groups as $group}
    {var $byCategory[$group->category ?: ''][] = $group}
{/foreach}

{var $categories = array_filter($byCategory)}
<div class="group-filter" role="search">
    <input type="search" id="group-search" placeholder="Gruppen durchsuchen…" aria-label="Gruppen durchsuchen" autocomplete="off">
    <div class="group-filter-chips" role="group" aria-label="Filter">
        <button type="button" id="filter-all" aria-pressed="true">Alle</button>
        <button type="button" n:foreach="$categories as $category => $categoryGroups" class="filter-category" data-category="{$category ?: 'Sonstiges'}" aria-pressed="false">
            {$category ?: 'Sonstiges'} <span class="count">{count($categoryGroups)}</span>
        </button>
        <button type="button" id="filter-mine" aria-pressed="false"><i class="ti ti-user-check" aria-hidden="true"></i> Nur meine Gruppen</button>
    </div>
</div>
<p id="group-filter-empty" class="group-filter-empty" hidden>Keine Gruppen gefunden.</p>

{foreach $categories as $category => $categoryGroups}
<section class="panel" data-category="{$category ?: 'Sonstiges'}" aria-labelledby="category-heading-{$category}">
    <div class="panel-heading">
        <h2 id="category-heading-{$category}">{$category ?: 'Sonstiges'}</h2>
        <span class="meta-note category-count">{count($categoryGroups)} Gruppe{count($categoryGroups) !== 1 ? 'n' : ''}</span>
    </div>

    <div class="group-list">
    {foreach $categoryGroups as $group}
        {var $isMember = $group->isMember($username)}
        {var $isOwner  = $group->isOwner($username)}
        {var $mayManage = $isGroupAdmin || $isOwner}
        {var $showMembers = $group->memberVisibility->value === 'all'
            || ($group->memberVisibility->value === 'members' && $isMember)
            || ($group->memberVisibility->value === 'owners'  && ($isOwner || $isGroupAdmin))}

        <div class="group-card" data-member="{$isMember ? 1 : 0}"
            data-search="{mb_strtolower(($group->displayName ?: '') . ' ' . $group->name . ' ' . ($group->description ?? '') . ' ' . ($group->mailAddress ?? ''))}">
            <div class="group-card-info">
                <span class="group-card-name">
                    <a href="/groups/{$group->name}">{$group->displayName ?: $group->name}</a>
                </span>
                <span n:if="$group->description" class="group-card-description">{$group->description}</span>
                <span class="group-card-meta">
                    <span n:if=$showMembers>{count($group->memberUsernames)} Mitglied{count($group->memberUsernames) !== 1 ? 'er'}</span>
                    <span n:if=$isMember class="badge"><i class="ti ti-check" aria-hidden="true"></i> Mitglied</span>
                    <span n:if=$isOwner class="badge owner"><i class="ti ti-crown" aria-hidden="true"></i> Gruppenverwalter*in</span>
                    <span n:if="$group->mailAddress"><i class="ti ti-mail" aria-hidden="true"></i> {$group->mailAddress}</span>
                    <span n:if="$group->visibility === \App\Model\Enum\GroupVisibility::Hidden"><i class="ti ti-eye-off" aria-hidden="true"></i> Versteckt</span>
                </span>
            </div>
            <div class="group-card-actions">
                {* Beitreten *}
                <button n:if="!$isMember && $group->joinPolicy->value === 'open'"
                    class="ghost"
                    data-action="/groups/{$group->name}/join"
                    onclick="groupAction(this.dataset.action, 'POST')">
                    <i class="ti ti-user-plus" aria-hidden="true"></i> Beitreten
                </button>
                {* Anfrage stellen *}
                <button n:if="!$isMember && $group->joinPolicy->value === 'request'"
                    class="ghost"
                    data-action="/groups/{$group->name}/join-requests"
                    onclick="groupAction(this.dataset.action, 'POST', 'Beitrittsanfrage gesendet.')">
                    <i class="ti ti-send" aria-hidden="true"></i> Beitritt anfragen
                </button>
                {* Nur auf Einladung — Info *}
                <span n:if="!$isMember && $group->joinPolicy->value === 'invite'" class="group-card-meta">
                    <i class="ti ti-lock" aria-hidden="true"></i> Nur auf Einladung
                </span>
                {* Verlassen *}
                <button n:if="$isMember && $group->leavePolicy === \App\Model\Enum\LeavePolicy::Allowed"
                    class="ghost leave"
                    data-action="/groups/{$group->name}/leave"
                    n:attr="data-confirm: !($group->joinPolicy === \App\Model\Enum\JoinPolicy::Open && $group->visibility === \App\Model\Enum\GroupVisibility::Public) ? 'Möchtest du die Gruppe wirklich verlassen?'"
        onclick="if (!this.dataset.confirm || confirm(this.dataset.confirm)) groupAction(this.dataset.action, 'POST')">
                    <i class="ti ti-user-minus" aria-hidden="true"></i> Verlassen
                </button>
            </div>
        </div>
    {/foreach}
    </div>
</section>
{/foreach}

{/block}

{block footer}

{* === Dialog: Neue Gruppe === *}
{embed dialog, id: 'group-create-dialog', labelIcon: 'users-group', label: 'Gruppen', title: 'Neue Gruppe anlegen'}
{block dialog-content}
<form id="group-create-form" onsubmit="submitGroupForm(event, this, '/groups', 'POST')">
    <div class="form-group">
        <label for="create-name">Technischer Name <small>(z.B. vorstand)</small></label>
        <input id="create-name" name="name" type="text" pattern="[a-z][a-z0-9\-_]*" required placeholder="z.B. vorstand">
    </div>
    <div class="form-group">
        <label for="create-displayName">Anzeigename</label>
        <input id="create-displayName" name="displayName" type="text" placeholder="z.B. Vorstand">
    </div>
    <div class="form-group">
        <label for="create-category">Kategorie</label>
        <input id="create-category" name="category" type="text" placeholder="z.B. Gremien">
    </div>
    <div class="form-actions">
        <button type="submit"><i class="ti ti-plus" aria-hidden="true"></i> Anlegen</button>
        <button type="button" class="secondary" onclick="document.getElementById('group-create-dialog').close()">Abbrechen</button>
    </div>
</form>
{/block}
{/embed}

<script>
{syntax off}
(function () {
    const search = document.getElementById('group-search');
    const allBtn = document.getElementById('filter-all');
    const mineBtn = document.getElementById('filter-mine');
    const catBtns = [...document.querySelectorAll('.filter-category')];
    const panels = [...document.querySelectorAll('section.panel[data-category]')];
    const emptyMsg = document.getElementById('group-filter-empty');

    const state = {categories: new Set(), q: '', mine: false};

    function readUrl() {
        const params = new URLSearchParams(location.search);
        const known = catBtns.map(b => b.dataset.category);
        state.categories = new Set(params.getAll('kategorie').filter(c => known.includes(c)));
        state.q = params.get('q') ?? '';
        state.mine = params.get('meine') === '1';
    }

    function buildUrl() {
        const params = new URLSearchParams();
        state.categories.forEach(c => params.append('kategorie', c));
        if (state.q.trim() !== '') params.set('q', state.q.trim());
        if (state.mine) params.set('meine', '1');
        const qs = params.toString();
        return location.pathname + (qs ? '?' + qs : '');
    }

    // zuletzt als eigener History-Eintrag gespeicherte URL; beim Tippen wird die URL nur per
    // replaceState nachgeführt und erst beim Verlassen des Suchfelds zu einem neuen Eintrag
    let committedUrl = location.pathname + location.search;

    function pushUrl() {
        const url = buildUrl();
        if (url === committedUrl) return;
        history.replaceState(null, '', committedUrl);
        history.pushState(null, '', url);
        committedUrl = url;
    }

    function render() {
        search.value = state.q;
        allBtn.setAttribute('aria-pressed', state.categories.size === 0);
        mineBtn.setAttribute('aria-pressed', state.mine);
        catBtns.forEach(b => b.setAttribute('aria-pressed', state.categories.has(b.dataset.category)));
        applyFilter();
    }

    function applyFilter() {
        const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
        let total = 0;
        panels.forEach(panel => {
            const catOk = state.categories.size === 0 || state.categories.has(panel.dataset.category);
            let visible = 0;
            panel.querySelectorAll('.group-card').forEach(card => {
                const ok = catOk
                    && (!state.mine || card.dataset.member === '1')
                    && words.every(w => card.dataset.search.includes(w));
                card.hidden = !ok;
                if (ok) visible++;
            });
            panel.hidden = visible === 0;
            panel.querySelector('.category-count').textContent = `${visible} Gruppe${visible !== 1 ? 'n' : ''}`;
            total += visible;
        });
        emptyMsg.hidden = total > 0;
    }

    allBtn.addEventListener('click', () => { state.categories.clear(); render(); pushUrl(); });
    mineBtn.addEventListener('click', () => { state.mine = !state.mine; render(); pushUrl(); });
    catBtns.forEach(b => b.addEventListener('click', () => {
        const c = b.dataset.category;
        state.categories.has(c) ? state.categories.delete(c) : state.categories.add(c);
        render();
        pushUrl();
    }));
    // beim Tippen sofort filtern und URL nachführen; History-Eintrag beim Verlassen des Feldes / mit Enter
    search.addEventListener('input', () => {
        state.q = search.value;
        applyFilter();
        history.replaceState(null, '', buildUrl());
    });
    search.addEventListener('change', () => { state.q = search.value; pushUrl(); });
    window.addEventListener('popstate', () => {
        committedUrl = location.pathname + location.search;
        readUrl();
        render();
    });

    readUrl();
    render();
})();

async function groupAction(url, method, successMessage) {
    try {
        const data = await callApi(method, url, new FormData());
        if (successMessage) alert(successMessage);
        if (data?.redirect) { window.location.href = data.redirect; } else { window.location.reload(); }
    } catch (err) { showError(err); }
}

async function submitGroupForm(event, form, url, method) {
    event.preventDefault();
    try {
        const data = await callApi(method || 'POST', url, new FormData(form));
        window.location.href = data?.redirect || '/groups';
    } catch (err) { showError(err); }
}
{/syntax}
</script>
{/block}
