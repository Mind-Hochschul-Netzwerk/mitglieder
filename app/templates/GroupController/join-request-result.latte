{var $navId = gruppen}

{block title}Beitrittsanfrage{/block}
{block page-label}<i class="ti ti-users-group" aria-hidden="true"></i> Gruppen{/block}

{block content}
<section class="panel">
    {if $action === 'approve'}
        {$requester?->fullName ?? $username} wurde erfolgreich zur Gruppe „{$group->displayName ?: $group->name}” hinzugefügt.
    {elseif $action === 'reject'}
        Die Beitrittsanfrage von {$requester?->fullName ?? $username} für die Gruppe „{$group->displayName ?: $group->name}” wurde abgelehnt.
    {/if}
    <div class="action-links">
        <a class="button" href="/groups">Zurück zur Gruppenübersicht</a>
    </div>
</section>
{/block}
