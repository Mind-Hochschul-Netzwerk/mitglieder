{var $navId = gruppen}

{define owner-row, $row}
<div class="form-group">
    <label for="edit-{$row['name']}">{$row['label']}</label>
    {if $row['type'] === 'enum'}
        <select id="edit-{$row['name']}" name="{$row['name']}">
            <option value="" n:attr="selected: !$row['isSet']">Standard ({$row['defaultText']})</option>
            <option n:foreach="$row['cases'] as $case" value="{$case->value}" n:attr="selected: $row['isSet'] && $case === $row['selected']">{$case->label()}</option>
        </select>
    {elseif $row['type'] === 'archiveMaxAge'}
        <select id="edit-{$row['name']}" name="{$row['name']}">
            <option value="" n:attr="selected: !$row['isSet']">Standard ({$row['defaultText']})</option>
            <option n:foreach="$row['options'] as $value => $label" value="{$value}" n:attr="selected: $row['isSet'] && $value === $row['selected']">{$label}</option>
        </select>
    {else}
        <input id="edit-{$row['name']}" name="{$row['name']}" type="text" value="{$row['isSet'] ? $row['text']}" placeholder="{$row['defaultText']}">
        <small>Leer = Standard</small>
    {/if}
</div>
{/define}

{block css}
<style>
.action-links .primary { background: var(--accent); color: #fff; }
.action-links .primary:hover, .action-links .primary:focus-visible { background: var(--accent-dark); }
.action-links .leave { background: transparent; color: var(--muted); border: 1.5px solid var(--border); }
.action-links .leave:hover, .action-links .leave:focus-visible { background: var(--panel-soft); }

.group-detail-panels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}
@media (max-width: 640px) {
    .group-detail-panels { grid-template-columns: 1fr; }
}
.group-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 1rem;
}
.group-panel-head {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-bottom: .6rem;
}
.group-panel-head .ti { color: var(--placeholder); }
.group-panel-head h2 { margin: 0; font-size: .8rem; font-weight: 600; }
.group-panel-count {
    font-size: .7rem;
    color: var(--placeholder);
    background: var(--panel-soft);
    padding: .1em .55em;
    border-radius: 99px;
}
.person-list { display: flex; flex-direction: column; }
.person-row {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .45rem 0;
    border-top: 1px solid var(--border);
}
.person-name {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: 1;
    min-width: 0;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.person-name .profile-image { flex: none; }
.remove-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    flex: none;
    border: none;
    background: none;
    color: var(--placeholder);
}
.remove-btn:hover, .remove-btn:focus-visible { color: #dc2626; background: none !important; }
.add-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    flex: none;
    border: none;
    background: none;
    color: var(--placeholder);
}
.add-btn:hover, .add-btn:focus-visible { color: #16a34a; background: none !important; }
.crown-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    flex: none;
    border: none;
    background: none;
    color: var(--placeholder);
}
.crown-btn:hover, .crown-btn:focus-visible { color: #713f12; background: none !important; }
.crown-btn.is-owner { color: #713f12; }
.crown-btn.is-owner:hover, .crown-btn.is-owner:focus-visible { color: var(--placeholder); }
.person-add-form {
    display: flex;
    gap: .4rem;
    margin-top: .75rem;
    padding-top: .75rem;
    border-top: 1px solid var(--border);
}
.text-muted { color: var(--muted); font-size: .85rem; }

.profile-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 99px;
    overflow: hidden;
    background: var(--accent-soft);
    color: var(--muted);
    font-size: .7rem;
    font-weight: 600;
    text-decoration: none;
    img { width: 100%; height: 100%; object-fit: cover; border-radius: 99px; }
}
.person-name:hover, .person-name:focus-visible { text-decoration: none; }
.person-name:hover .person-name-text, .person-name:focus-visible .person-name-text { text-decoration: underline; }
.person-name + span { display: flex; align-items: center; gap: .25rem; }
.badge {
    display: inline-flex;
    align-items: center;
    gap: .25rem;
    font-size: .72rem;
    font-weight: 600;
    padding: .2em .6em;
    border-radius: 99px;
    background: var(--accent-soft);
    color: var(--accent);
}
.badge.owner { background: #fef9c3; color: #713f12; }

</style>
{/block}

{block title}{$group->displayName ?: $group->name}{/block}
{block page-label}<i class="ti ti-users-group" aria-hidden="true"></i> <a href="/groups">Gruppen</a> / {$group->category ?: Sonstiges}{/block}

{block page-header}
<div class="summary">{($group->description ?? '')|breakLines}</div>
<div class="meta">
    <span n:if="$group->mailAddress"><i class="ti ti-mail" aria-hidden="true"></i> <a n:tag-if="$canWriteMail" href="mailto:{$group->mailAddress}">{$group->mailAddress}</a></span>
</div>
<div class="action-links" n:ifcontent>
    <a n:if="$canWriteMail && $group->mailAddress" href="mailto:{$group->mailAddress}">
        <i class="ti ti-mail" aria-hidden="true"></i> Mail schreiben
    </a>
    <a n:if="$archiveUrl" href="{$archiveUrl}">
        <i class="ti ti-archive" aria-hidden="true"></i> Archiv
    </a>
    <button n:if="!$isMember && $group->effectiveJoinPolicy === \App\Model\Enum\JoinPolicy::Open"
        data-action="/groups/{$group->name}/join"
        onclick="groupAction(this.dataset.action, 'POST')">
        <i class="ti ti-user-plus" aria-hidden="true"></i> Beitreten
    </button>
    <button n:if="!$isMember && $group->effectiveJoinPolicy === \App\Model\Enum\JoinPolicy::Request"
        data-action="/groups/{$group->name}/join-requests"
        onclick="groupAction(this.dataset.action, 'POST', 'Deine Anfrage wurde gesendet.')">
        <i class="ti ti-send" aria-hidden="true"></i> Beitritt anfragen
    </button>
    <button n:if="$isMember && $group->effectiveLeavePolicy === \App\Model\Enum\LeavePolicy::Direct"
        class="leave"
        data-action="/groups/{$group->name}/leave"
        n:attr="data-confirm: !($group->effectiveJoinPolicy === \App\Model\Enum\JoinPolicy::Open && $group->effectiveVisibility === \App\Model\Enum\GroupVisibility::Authenticated) ? 'Möchtest du die Gruppe wirklich verlassen?'"
        onclick="if (!this.dataset.confirm || confirm(this.dataset.confirm)) groupAction(this.dataset.action, 'POST')">
        <i class="ti ti-user-minus" aria-hidden="true"></i> Gruppe verlassen
    </button>
    <a n:if="$mayManage && $isGroupAdmin" class="primary" href="/groups/{$group->name}/settings">
        <i class="ti ti-settings" aria-hidden="true"></i> Einstellungen
    </a>
    <button n:if="$mayManage && !$isGroupAdmin" class="primary"
        onclick="document.getElementById('group-edit-dialog').showModal()">
        <i class="ti ti-settings" aria-hidden="true"></i> Einstellungen
    </button>
</div>
{/block}

{block content}

<section class="panel" aria-labelledby="rules-heading">
    <div class="panel-heading">
        <h2 id="rules-heading"><i class="label-icon ti ti-list-details" aria-hidden="true"></i>Gruppenregeln</h2>
    </div>
    {include 'rules.latte', group: $group, agreement: $requiredAgreement, insider: $isMember || $isOwner || $isGroupAdmin}
</section>

<section class="panel" aria-labelledby="members-heading">
    <div class="panel-heading">
        <h2 id="members-heading"><i class="label-icon ti ti-users" aria-hidden="true"></i>Mitglieder</h2>
        {* auch bei nicht sichtbarer Mitgliederliste wird die Anzahl der Mitglieder angezeigt *}
        {var $memberCount = $showMembers ? count($displayInfos) : count($group->memberUsernames)}
        <span n:if=$memberCount class="meta-note" id="member-count" data-count="{$memberCount}">{$memberCount} Mitglied{$memberCount !== 1 ? 'er'}</span>
    </div>

    {* wer die Mitgliederliste sehen darf: Mitglieder und Verwaltung erfahren es, wenn sie die Liste sehen; Nichtmitglieder sehen selbst, ob sie sie sehen können *}
    <p n:if="$showMembers && ($isMember || $isOwner || $isGroupAdmin)" class="text-muted">
        {switch $group->effectiveMemberVisibility->value}
            {case all}Die Mitgliederliste der Gruppe ist für alle Mitglieder des MHN sichtbar.
            {case members}Die Mitgliederliste ist nur für die Mitglieder der Gruppe sichtbar. Gruppenverwalter*innen sind für alle MHN-Mitglieder sichtbar.
            {case owners}Die Mitgliederliste ist nur für die Gruppenverwaltung sichtbar. Gruppenverwalter*innen selbst sind für alle MHN-Mitglieder sichtbar.
        {/switch}
    </p>

    <p n:if="!$showMembers" class="text-muted">{if $displayInfos}Die vollständige Mitgliederliste ist nicht öffentlich sichtbar, hier werden nur die Gruppenverwalter*innen angezeigt.{else}Die Mitgliederliste ist nicht öffentlich sichtbar.{/if}</p>

    <div class="person-list" n:if="$displayInfos" n:inner-foreach="$displayInfos as $info">
        <div class="person-row" data-username="{$info->userName}" data-realname="{$info->realName}">
            <a href="/user/{$info->userName}" class="person-name">
                <span class="profile-image">
                    {if $info->hasProfilePicture}
                        <img src="/user/{$info->userName}/profile-picture?size=thumbnail" alt="Profilbild von {$info->realName}">
                    {else}
                        {$info->initials}
                    {/if}
                </span>
                <span class="person-name-text">{$info->realName}</span>
            </a>
            <span>
                {if $group->isOwner($info->userName)}
                    <span class="badge owner"><i class="ti ti-crown" aria-hidden="true"></i> Gruppenverwalter*in</span>
                {/if}
                <button n:if="$mayManage && ($isGroupAdmin || $info->userName !== $username || !$group->isOwner($info->userName))"
                    class="crown-btn{if $group->isOwner($info->userName)} is-owner{/if}"
                    data-action="/groups/{$group->name}/owners/{$info->userName}"
                    data-username="{$info->userName}"
                    onclick="toggleOwner(this)"
                    aria-label="{if $group->isOwner($info->userName)}Als Gruppenverwalter*in zurückstufen{else}Zum/zur Gruppenverwalter*in befördern{/if}"
                    title="{if $group->isOwner($info->userName)}Als Gruppenverwalter*in zurückstufen{else}Zum/zur Gruppenverwalter*in befördern{/if}">
                    <i class="ti ti-crown" aria-hidden="true"></i>
                </button>
                <button n:if="$mayManage && $group->isMember($info->userName)" class="remove-btn"
                    data-action="/groups/{$group->name}/members/{$info->userName}"
                    data-username="{$info->userName}"
                    onclick="removeMember(this)"
                    aria-label="Mitglied entfernen">
                    <i class="ti ti-x" aria-hidden="true"></i>
                </button>
                <button n:if="$mayManage && !$group->isMember($info->userName)" class="add-btn"
                    data-action="/groups/{$group->name}/members/{$info->userName}"
                    data-username="{$info->userName}"
                    onclick="addBackMember(this)"
                    aria-label="Als Mitglied hinzufügen"
                    title="Ist (noch) kein Mitglied &ndash; wieder als Mitglied hinzufügen">
                    <i class="ti ti-user-plus" aria-hidden="true"></i>
                </button>
            </span>
        </div>
    </div>
    <p n:if="$showMembers && !$displayInfos" class="text-muted" id="no-members">Noch keine Mitglieder.</p>

    {* Mitglied hinzufügen *}
    {if $mayManage && $showMembers}
    <form class="person-add-form" onsubmit="addMember(event, this)">
        <datalist id="non-members-list">
            {foreach $nonMembers as $info}
                <option value="{$info->userName}" data-realname="{$info->realName}" data-initials="{$info->initials}" n:attr="data-pic: $info->hasProfilePicture ? 1">{$info->realName} ({$info->userName})</option>
            {/foreach}
        </datalist>
        <div class="input-group">
        <input type="search" list="non-members-list" name="username" placeholder="Hinzufügen…" autocomplete="off" required>
        <button type="submit" aria-label="Mitglied hinzufügen"><i class="ti ti-user-plus" aria-hidden="true"></i></button>
        </div>
    </form>
    {/if}
</section>

{/block}

{block footer}

{* === Dialog: Einstellungen (Gruppenverwalter*innen; groupadmin nutzen die Einstellungsseite) === *}
{if $mayManage && !$isGroupAdmin}
{embed dialog, id: 'group-edit-dialog', labelIcon: 'settings', label: 'Gruppe', title: 'Einstellungen'}
{block dialog-content}
<form data-action="/groups/{$group->name}/settings" onsubmit="submitForm(event, this, this.dataset.action, 'POST')">
    <div class="form-group">
        <label for="edit-displayName">Anzeigename</label>
        <input id="edit-displayName" name="displayName" type="text" value="{$group->displayName}" placeholder="{$group->name}">
    </div>
    <div class="form-group">
        <label for="edit-description">Beschreibung</label>
        <textarea id="edit-description" name="description" rows="3">{$group->description}</textarea>
    </div>
    <div class="form-group">
        <label for="edit-category">Kategorie</label>
        <input id="edit-category" name="category" type="text" value="{$group->category}">
    </div>
    {foreach $ownerRows['always'] as $row}
        {include owner-row, row: $row}
    {/foreach}
    {include required-agreement, id: 'edit-requiredAgreement', group: $group, versions: $agreementVersions}
    <fieldset n:if="$group->hasListPassword()">
        <legend>Mailingliste</legend>
        {foreach $ownerRows['list'] as $row}
            {include owner-row, row: $row}
        {/foreach}
    </fieldset>
    <div class="form-actions">
        <button type="submit"><i class="ti ti-device-floppy" aria-hidden="true"></i> Speichern</button>
        <button type="button" class="secondary" onclick="this.closest('dialog').close()">Abbrechen</button>
    </div>
</form>
{/block}
{/embed}
{/if}

<script>
groupname = {$group->name};
currentUsername = {$username};
isGroupAdmin = {if $isGroupAdmin}true{else}false{/if};
{syntax off}
async function groupAction(url, method, successMessage) {
    try {
        const data = await callApi(method, url, new FormData());
        if (successMessage) alert(successMessage);
        if (data?.redirect) { window.location.href = data.redirect; } else { window.location.reload(); }
    } catch (err) { showError(err); }
}

async function submitForm(event, form, url, method) {
    event?.preventDefault();
    try {
        const data = await callApi(method, url, form ? new FormData(form) : new FormData());
        if (data?.redirect) { window.location.href = data.redirect; } else { window.location.reload(); }
    } catch (err) { showError(err); }
}

const collator = new Intl.Collator('de');

function makeCrownButton(username) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'crown-btn';
    btn.dataset.action = `/groups/${groupname}/owners/${username}`;
    btn.dataset.username = username;
    btn.onclick = () => toggleOwner(btn);
    const label = 'Zum/zur Gruppenverwalter*in befördern';
    btn.setAttribute('aria-label', label);
    btn.title = label;
    const icon = document.createElement('i');
    icon.className = 'ti ti-crown';
    icon.setAttribute('aria-hidden', 'true');
    btn.appendChild(icon);
    return btn;
}

function makePersonRow(username, realName, initials, hasPicture) {
    const row = document.createElement('div');
    row.className = 'person-row';
    row.dataset.username = username;
    row.dataset.realname = realName;

    const link = document.createElement('a');
    link.href = `/user/${encodeURIComponent(username)}`;
    link.className = 'person-name';
    const avatar = document.createElement('span');
    avatar.className = 'profile-image';
    if (hasPicture) {
        const img = document.createElement('img');
        img.src = `/user/${encodeURIComponent(username)}/profile-picture?size=thumbnail`;
        img.alt = `Profilbild von ${realName}`;
        avatar.appendChild(img);
    } else {
        avatar.textContent = initials;
    }
    const nameText = document.createElement('span');
    nameText.className = 'person-name-text';
    nameText.textContent = realName;
    link.append(avatar, nameText);

    const actions = document.createElement('span');
    actions.append(
        makeCrownButton(username),
        makeMemberButton('remove', `/groups/${groupname}/members/${username}`, username),
    );
    row.append(link, actions);
    return row;
}

// fügt die Zeile alphabetisch (nach realName) ein, ohne die übrige Liste anzufassen
function insertPersonRow(row) {
    let list = document.querySelector('.person-list');
    if (!list) {
        list = document.createElement('div');
        list.className = 'person-list';
        const form = document.querySelector('.person-add-form');
        form.parentNode.insertBefore(list, form);
        document.getElementById('no-members')?.remove();
    }
    const next = [...list.querySelectorAll('.person-row')]
        .find(r => collator.compare(r.dataset.realname, row.dataset.realname) > 0);
    list.insertBefore(row, next ?? null);
}

async function addMember(event, form) {
    event.preventDefault();
    const input = form.querySelector('[name=username]');
    const username = input.value;
    const option = [...form.querySelectorAll('datalist option')].find(o => o.value === username);
    const action = `/groups/${groupname}/members/${username}`;
    try {
        await callApi('POST', action, new FormData());
    } catch (err) { showError(err); return; }

    const existingRow = [...document.querySelectorAll('.person-row')].find(r => r.dataset.username === username);
    if (existingRow) {
        // war als Gruppenverwalter*in schon in der Liste, aber noch kein Mitglied
        const addBtn = existingRow.querySelector('.add-btn');
        if (addBtn) addBtn.replaceWith(makeMemberButton('remove', action, username));
    } else if (option) {
        insertPersonRow(makePersonRow(username, option.dataset.realname, option.dataset.initials, !!option.dataset.pic));
        updateMemberCount(1);
    } else {
        window.location.reload();
        return;
    }
    option?.remove();
    input.value = '';
    input.focus();
}

async function addOwner(event, form) {
    event.preventDefault();
    const username = form.querySelector('[name=username]').value;
    await groupAction(`/groups/${groupname}/owners/${username}`, 'POST');
}

function updateMemberCount(delta) {
    const el = document.getElementById('member-count');
    if (!el) return;
    const n = parseInt(el.dataset.count, 10) + delta;
    el.dataset.count = n;
    el.textContent = `${n} Mitglied${n !== 1 ? 'er' : ''}`;
}

function makeMemberButton(kind, action, username) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.dataset.action = action;
    btn.dataset.username = username;
    const icon = document.createElement('i');
    icon.setAttribute('aria-hidden', 'true');
    if (kind === 'remove') {
        btn.className = 'remove-btn';
        btn.onclick = () => removeMember(btn);
        btn.setAttribute('aria-label', 'Mitglied entfernen');
        icon.className = 'ti ti-x';
    } else {
        btn.className = 'add-btn';
        btn.onclick = () => addBackMember(btn);
        btn.setAttribute('aria-label', 'Als Mitglied hinzufügen');
        btn.title = 'Ist (noch) kein Mitglied – wieder als Mitglied hinzufügen';
        icon.className = 'ti ti-user-plus';
    }
    btn.appendChild(icon);
    return btn;
}

async function toggleOwner(button) {
    const wasOwner = button.classList.contains('is-owner');
    const username = button.dataset.username;
    try {
        await callApi(wasOwner ? 'DELETE' : 'POST', button.dataset.action, new FormData());
        const nowOwner = !wasOwner;
        const row = button.closest('.person-row');
        const actionsSpan = row.querySelector('.person-name + span');
        let badge = actionsSpan.querySelector('.badge.owner');
        if (nowOwner && !badge) {
            badge = document.createElement('span');
            badge.className = 'badge owner';
            const icon = document.createElement('i');
            icon.className = 'ti ti-crown';
            icon.setAttribute('aria-hidden', 'true');
            badge.appendChild(icon);
            badge.append(' Gruppenverwalter*in');
            actionsSpan.insertBefore(badge, actionsSpan.firstChild);
        } else if (!nowOwner && badge) {
            badge.remove();
        }
        button.classList.toggle('is-owner', nowOwner);
        const label = nowOwner ? 'Als Gruppenverwalter*in zurückstufen' : 'Zum/zur Gruppenverwalter*in befördern';
        button.setAttribute('aria-label', label);
        button.title = label;
        // Selbst-Herabstufung ist serverseitig nur für Gruppenadmins erlaubt (siehe removeOwner) -
        // der Button darf dann für die eigene Zeile nicht mehr angeboten werden.
        if (nowOwner && username === currentUsername && !isGroupAdmin) {
            button.remove();
        }
    } catch (err) { showError(err); }
}

// Person wieder in der Vorschlagsliste des Hinzufügen-Feldes anbieten
function addNonMemberOption(username, row) {
    const list = document.getElementById('non-members-list');
    if (!list) return;
    const realName = row.dataset.realname;
    const option = document.createElement('option');
    option.value = username;
    option.dataset.realname = realName;
    option.dataset.initials = row.querySelector('.profile-image').textContent.trim();
    if (row.querySelector('.profile-image img')) option.dataset.pic = '1';
    option.textContent = `${realName} (${username})`;
    list.appendChild(option);
}

async function removeMember(button) {
    const username = button.dataset.username;
    const action = button.dataset.action;
    const row = button.closest('.person-row');
    const isOwner = row.querySelector('.badge.owner') !== null;
    try {
        await callApi('DELETE', action, new FormData());
        if (isOwner) {
            // Owner bleiben immer sichtbar, auch ohne Mitgliedschaft - Button wird zum Wieder-hinzufügen-Button
            button.replaceWith(makeMemberButton('add', action, username));
        } else {
            row.remove();
            updateMemberCount(-1);
            addNonMemberOption(username, row);
        }
    } catch (err) { showError(err); }
}

async function addBackMember(button) {
    const username = button.dataset.username;
    const action = button.dataset.action;
    try {
        await callApi('POST', action, new FormData());
        button.replaceWith(makeMemberButton('remove', action, username));
    } catch (err) { showError(err); }
}
{/syntax}
</script>
{/block}
